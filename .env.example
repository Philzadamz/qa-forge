# Copy to .env and adjust. All values are optional in local dev.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database — default is SQLite under var/ (docs/decisions/001).
# With Docker: DATABASE_URL=postgresql+psycopg://qaforge:qaforge@localhost:5432/qaforge
# DATABASE_URL=

# Object storage — "local" (var/storage) or "s3" (MinIO/S3)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=qa-forge
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Queue — leave empty to run jobs in-process (no Redis)
# REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Fernet key for encrypted secrets — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_KEY=

# Web app → API proxy target
API_URL=http://localhost:8000

# Android runner (PRD §7.6.3) — aapt/aapt2 and the emulator binary are usually NOT on PATH
# even with the Android SDK installed; point these at the real paths under your SDK install.
# ANDROID_AVD_NAME=QAForgeTest
# ANDROID_APPIUM_URL=http://127.0.0.1:4723
# ANDROID_ADB_PATH=/Users/you/Library/Android/sdk/platform-tools/adb
# ANDROID_AAPT_PATH=/Users/you/Library/Android/sdk/build-tools/<version>/aapt
# ANDROID_EMULATOR_PATH=/Users/you/Library/Android/sdk/emulator/emulator

# AI cost estimate (dashboard). Leave at 0 unless you want an estimate — set to your provider's
# current published rate per million tokens. A hardcoded price would go stale.
# AI_COST_PER_MILLION_INPUT_TOKENS=0
# AI_COST_PER_MILLION_OUTPUT_TOKENS=0

# Hosts the server may fetch from even though they resolve to a private address (docs/decisions/009).
# Keep empty in production. JSON list, e.g. ["127.0.0.1"] for the local demo API.
# SSRF_ALLOWED_HOSTS=[]

# Retention (PRD §12). Run `make retention-sweep` on a schedule (e.g. daily cron).
# RETENTION_EVIDENCE_DAYS=180
# RETENTION_AUDIT_LOG_DAYS=730
