# Copy to .env and adjust. All values are optional in local dev.

ENVIRONMENT=dev
LOG_LEVEL=INFO

# Database — default is SQLite under var/ (docs/decisions/001).
# With Docker: DATABASE_URL=postgresql+psycopg://qaforge:qaforge@localhost:5432/qaforge
# DATABASE_URL=

# Object storage — "local" (var/storage) or "s3" (MinIO/S3)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=qa-forge
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Queue — leave empty to run jobs in-process (no Redis)
# REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Fernet key for encrypted secrets — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_KEY=

# Web app → API proxy target
API_URL=http://localhost:8000
